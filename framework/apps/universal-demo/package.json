{
  "name": "universal-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Universal demo app for INDJS",
  "author": "INDJS Team",
  "build": {
    "appId": "com.indjs.universaldemo",
    "productName": "UniversalDemo",
    "files": [
      "electron/**/*",
      ".indjs/static/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "indjs dev",
    "build": "indjs build",
    "start": "indjs start",
    "test": "indjs test",
    "desktop:dev": "concurrently -k \"indjs dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "indjs build && electron-builder",
    "android:setup": "node scripts/setup-android.cjs",
    "android:dev": "npm run build && npx cap sync android && npx cap run android",
    "android:open": "npx cap open android",
    "mobile:dev": "npm run android:dev",
    "mobile:android": "npm run android:dev",
    "mobile:ios": "npx cap open ios",
    "mobile:build": "indjs build && npx cap sync",
    "build:all": "npm run build && npm run desktop:build && npm run mobile:build"
  },
  "dependencies": {
    "indjs": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "electron-serve": "^1.3.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "@capacitor/cli": "^6.0.0"
  },
  "main": "electron/main.cjs"
}