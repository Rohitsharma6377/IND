{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "declaration": true,
        "emitDeclarationOnly": false,
        "outDir": "dist"
    },
    "include": [
        "src/**/*",
        "bin/**/*",
        "types.d.ts"
    ],
    "exclude": [
        "node_modules",
        "tests",
        "**/*.test.ts"
    ]
}