{
  "appId": "com.indjs.universalapp",
  "appName": "INDJS Universal App",
  "webDir": ".indjs/static",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#4F46E5",
      "showSpinner": true,
      "spinnerColor": "#FFFFFF"
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#4F46E5"
    }
  }
}
