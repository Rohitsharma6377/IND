{
    "name": "indjs-todo-app",
    "version": "1.0.0",
    "description": "Beautiful Todo List App - Web + Mobile + Desktop with INDJS",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "indjs dev",
        "build": "indjs build",
        "start": "indjs start",
        "desktop:dev": "concurrently \"indjs dev\" \"wait-on http://localhost:3000 && electron .\"",
        "desktop:build": "indjs build && electron-builder",
        "desktop:build:all": "indjs build && electron-builder -mwl",
        "desktop:build:windows": "indjs build && electron-builder --win",
        "desktop:build:mac": "indjs build && electron-builder --mac",
        "desktop:build:linux": "indjs build && electron-builder --linux",
        "android:setup": "npx cap init \"Todo App\" \"com.indjs.todo\" --web-dir=.indjs/static && npx cap add android",
        "android:build": "npm run build && npx cap sync android",
        "android:sync": "npx cap sync android",
        "android:open": "npx cap open android",
        "android:run": "npx cap run android",
        "android:dev": "npm run build && npx cap sync android && npx cap run android",
        "mobile:setup": "npm run android:setup",
        "mobile:dev": "npm run android:dev",
        "mobile:build": "npm run android:build",
        "mobile:run": "npm run android:run",
        "test": "indjs test"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "indjs": "latest",
        "@capacitor/core": "^6.0.0",
        "@capacitor/preferences": "^6.0.0",
        "@capacitor/app": "^6.0.0",
        "@capacitor/android": "^6.0.0",
        "@capacitor/ios": "^6.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.0.0",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "concurrently": "^8.2.2",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.indjs.todoapp",
        "productName": "INDJS Todo App",
        "directories": {
            "output": "dist"
        },
        "files": [
            ".indjs/static/**/*",
            "electron/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "assets/icon.ico"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "icon": "assets/icon.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "assets/icon.png"
        }
    }
}