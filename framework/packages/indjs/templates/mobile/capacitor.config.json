{
    "appId": "com.indjs.mobileapp",
    "appName": "INDJS Mobile App",
    "webDir": ".indjs/static",
    "server": {
        "androidScheme": "https"
    },
    "plugins": {
        "SplashScreen": {
            "launchShowDuration": 2000,
            "backgroundColor": "#4F46E5",
            "showSpinner": true,
            "spinnerColor": "#FFFFFF",
            "androidSpinnerStyle": "small",
            "iosSpinnerStyle": "small"
        },
        "StatusBar": {
            "style": "dark",
            "backgroundColor": "#4F46E5"
        },
        "PushNotifications": {
            "presentationOptions": [
                "badge",
                "sound",
                "alert"
            ]
        }
    }
}