{
  "name": "indjs",
  "version": "2.0.2",
  "description": "A modern, fast, and lightweight full-stack React framework with file-based routing, SSR, and built-in optimizations",
  "type": "module",
  "author": "INDJS Team || Rohit sharma",
  "license": "MIT",
  "homepage": "https://github.com/Rohitsharma6377/IND#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rohitsharma6377/IND.git"
  },
  "bugs": {
    "url": "https://github.com/Rohitsharma6377/IND/issues"
  },
  "keywords": [
