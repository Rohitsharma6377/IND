# Copy values into a private server environment; never commit real secrets.
PORT=4310
COMMERCE_BIND=127.0.0.1
COMMERCE_DB=data/commerce.db
COMMERCE_PUBLIC_ORIGIN=https://commerce.netcuriontechnology.com
COMMERCE_DOMAIN_TARGET=commerce.netcuriontechnology.com
# Optional explicit public IPv4 ingress list, comma separated.
COMMERCE_DOMAIN_IPV4=66.116.248.221
# Required for storing gateway credentials: 32 random bytes encoded as hex/base64.
COMMERCE_MASTER_KEY=
# Keep off until provider sandbox, deployment and go-live checks are complete.
COMMERCE_ALLOW_LIVE_PAYMENTS=0
# Disable self-serve account creation for a marketing-only initial deployment.
COMMERCE_ALLOW_SIGNUP=0
COMMERCE_AI_MODEL=
