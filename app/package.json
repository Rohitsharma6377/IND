{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "indjs dev",
    "build": "npm run build",
    "start": "indjs start",
    "test": "indjs test",
    "preview": "cd .indjs/static && npx serve .",
    "deploy:vercel": "npm run build && npx vercel --prod",
    "deploy:netlify": "npm run build && npx netlify deploy --prod --dir .indjs/static",
    "deploy": "npm run build && echo 'Build complete! Deploy the .indjs/static folder to your hosting provider.'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@reduxjs/toolkit": "^2.3.0",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "indjs": "^1.0.13",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^3.4.18",
    "autoprefixer": "^10.4.21"
  }
}